NODE_ENV=development
APP_NAME=new-erp-final
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
DATABASE_URL=postgresql://erp_app:<erp-app-password>@postgres:5432/newerp
DATABASE_SSL_MODE=disable
# Production platform procedures MUST use the separate erp_platform_executor credential.
# Local development may omit PLATFORM_DATABASE_URL; production must use erp_platform_executor.
# PLATFORM_DATABASE_URL=postgresql://erp_platform_executor:<executor-password>@postgres:5432/newerp
TEST_DATABASE_URL=postgresql://postgres:<postgres-password>@postgres:5432/newerp_test
# Canonical database provisioning uses three explicit credential boundaries.
# DB_PROVISIONING_DATABASE_URL is privileged and used only by the provisioning/security stage.
# DB_MIGRATION_DATABASE_URL is the object-creating migration role, normally erp.
# DATABASE_URL is the runtime application role, normally erp_app.
# Local Docker provisioning uses the postgres database owner credential.
DB_PROVISIONING_DATABASE_URL=postgresql://postgres:<postgres-password>@postgres:5432/newerp
# Local Docker migrations use the dedicated erp migration credential.
DB_MIGRATION_DATABASE_URL=postgresql://erp:<erp-password>@postgres:5432/newerp
# PGHOST=localhost
PGPORT=5432
PGDATABASE=newerp
PGUSER=postgres
PGPASSWORD=<postgres-password>
# Optional explicit password used when integration setup provisions the non-bypass security roles.
# If DATABASE_URL uses erp_app locally, its URL password is used when this is absent.
ADR0040_SECURITY_ROLE_PASSWORD=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=25
JWT_SECRET=replace-with-a-strong-development-secret
JWT_ISSUER=new-erp-final
# HS256 is the compatibility default. Production migration target is RS256 per ADR-0021/security baseline.
JWT_SIGNING_ALGORITHM=HS256
# JSON array of {kid,state,publicKeyPem,privateKeyPem?}. Keep private key material in deployment secret storage.
JWT_RS256_KEYS_JSON=[]
# Enable only during a bounded RS256 migration window for already-issued HS256 tokens.
JWT_ACCEPT_LEGACY_HS256=false
# Required in production. Used to encrypt persisted TOTP secrets with AES-256-GCM.
MFA_ENCRYPTION_KEY=replace-with-a-strong-secret-at-least-32-characters
TENANT_CONTEXT_KEY=app.current_tenant_id
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBER=true
AUTH_PASSWORD_REQUIRE_SYMBOL=true
# Production: comma-separated exact browser origins.
# Development/test additionally allow http://localhost:<any-port> and http://127.0.0.1:<any-port>.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Controlled known-login tenant seed. Disabled unless explicitly enabled.
CUSTOM_TENANT_SEED_ENABLED=false

# Docker Compose PostgreSQL 18 service settings. Keep real values only in .env.local.
POSTGRES_DB=newerp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres-password>

# Initial platform administrator used by the canonical database provisioning step.
PLATFORM_ADMIN_USERNAME=superuser
PLATFORM_ADMIN_PASSWORD=<platform-admin-password>
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_RESET_PASSWORD=false
# Required when CUSTOM_TENANT_SEED_ENABLED=true; never commit these values.
CUSTOM_TENANT_ADMIN_PASSWORD=
CUSTOM_TENANT_USER_PASSWORD=
CUSTOM_TENANT_MANAGER_PASSWORD=
# Production requires this second explicit opt-in for the controlled test tenant.
CUSTOM_TENANT_SEED_ALLOW_PRODUCTION=false
