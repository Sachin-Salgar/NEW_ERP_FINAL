NODE_ENV=development
APP_NAME=new-erp-final
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_dev
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-a-strong-development-secret
