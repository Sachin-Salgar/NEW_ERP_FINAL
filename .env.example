NODE_ENV=development
APP_NAME=new-erp-final
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/your_local_database
# Local development: use the Render External PostgreSQL URL with TLS and certificate validation.
# DATABASE_URL=postgresql://<user>:<password>@<render-external-host>:5432/<database>
DATABASE_SSL_MODE=require
# Render production: use the Render Internal PostgreSQL URL over Render's private network.
# DATABASE_URL=postgresql://<user>:<password>@<render-internal-host>:5432/<database>
# DATABASE_SSL_MODE=disable
TEST_DATABASE_URL=postgresql://<test-user>:<test-password>@localhost:5432/your_test_database
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_local_database
PGUSER=postgres
PGPASSWORD=CHANGE_ME
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=25
JWT_SECRET=replace-with-a-strong-development-secret
JWT_ISSUER=new-erp-final
TENANT_CONTEXT_KEY=app.current_tenant_id
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBER=true
AUTH_PASSWORD_REQUIRE_SYMBOL=true
# Production: comma-separated exact browser origins.
# Development/test additionally allow http://localhost:<any-port> and http://127.0.0.1:<any-port>.
CORS_ALLOWED_ORIGINS=https://erp.example.com,https://admin.example.com
