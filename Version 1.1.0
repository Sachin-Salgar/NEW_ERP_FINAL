-- ============================================================================
-- Production-Grade SaaS ERP Core Framework Database Schema (PostgreSQL)
-- Version 1.1.0 (Corrected / Hardened Revision)
-- ============================================================================
-- BASE ENTITY STANDARD & OWNERSHIP RULE
-- Every tenant-owned business table stores tenant_id directly.
-- Company-level data also stores organization_id.
-- Location-level data also stores branch_id.
-- Never infer tenant through joins; store it directly.
-- ============================================================================

BEGIN;

-- ============================================================================
-- EXTENSIONS
-- ============================================================================

CREATE EXTENSION IF NOT EXISTS "pgcrypto";
CREATE EXTENSION IF NOT EXISTS "citext";

-- ============================================================================
-- CUSTOM ENUM TYPES
-- ============================================================================

DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'tenant_status_enum') THEN
        CREATE TYPE tenant_status_enum AS ENUM ('active', 'suspended', 'trial', 'expired', 'cancelled', 'maintenance');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'subscription_status_enum') THEN
        CREATE TYPE subscription_status_enum AS ENUM ('active', 'past_due', 'canceled', 'trialing');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'user_status_enum') THEN
        CREATE TYPE user_status_enum AS ENUM ('active', 'inactive', 'locked', 'pending_verification');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'org_status_enum') THEN
        CREATE TYPE org_status_enum AS ENUM ('active', 'inactive', 'archived');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'fy_status_enum') THEN
        CREATE TYPE fy_status_enum AS ENUM ('open', 'closed', 'locked');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'reset_policy_enum') THEN
        CREATE TYPE reset_policy_enum AS ENUM ('financial_year', 'calendar_year', 'monthly', 'never');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'storage_provider_enum') THEN
        CREATE TYPE storage_provider_enum AS ENUM ('local', 'aws_s3', 'azure_blob', 'minio', 'gcp');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'audit_action_enum') THEN
        CREATE TYPE audit_action_enum AS ENUM ('create', 'update', 'delete', 'restore', 'approve', 'reject', 'cancel', 'login', 'logout');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'scan_status_enum') THEN
        CREATE TYPE scan_status_enum AS ENUM ('pending', 'clean', 'infected', 'quarantined');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'notification_type_enum') THEN
        CREATE TYPE notification_type_enum AS ENUM ('info', 'warning', 'error', 'success', 'system', 'approval', 'workflow', 'reminder');
    END IF;

    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'permission_scope_enum') THEN
        CREATE TYPE permission_scope_enum AS ENUM ('own', 'branch', 'organization', 'tenant', 'global');
    END IF;
END $$;

-- ============================================================================
-- HELPER FUNCTIONS
-- ============================================================================

CREATE OR REPLACE FUNCTION app_current_tenant_id()
RETURNS UUID
LANGUAGE sql
STABLE
AS $$
    SELECT NULLIF(current_setting('app.current_tenant_id', true), '')::uuid
$$;

CREATE OR REPLACE FUNCTION update_timestamp_and_version()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.updated_at = NOW();

    IF TG_OP = 'UPDATE' AND OLD.version IS NOT NULL THEN
        NEW.version = OLD.version + 1;
    END IF;

    RETURN NEW;
END;
$$;

CREATE OR REPLACE FUNCTION prevent_audit_mutation()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    RAISE EXCEPTION 'Audit logs are immutable and cannot be updated or deleted.';
END;
$$;

-- ============================================================================
-- 1. PLATFORM-OWNED TABLES
-- ============================================================================

CREATE TABLE IF NOT EXISTS subscription_plans (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100) NOT NULL,
    description TEXT,
    price_monthly NUMERIC(10, 2) NOT NULL DEFAULT 0.00 CHECK (price_monthly >= 0),
    max_users INTEGER CHECK (max_users IS NULL OR max_users >= 0),
    max_storage_gb INTEGER CHECK (max_storage_gb IS NULL OR max_storage_gb >= 0),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ
);

CREATE TABLE IF NOT EXISTS modules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    parent_module_id UUID REFERENCES modules(id) ON DELETE CASCADE,
    code VARCHAR(100) NOT NULL UNIQUE,
    name VARCHAR(150) NOT NULL,
    module_group VARCHAR(100) NOT NULL DEFAULT 'Administration',
    description TEXT,
    icon VARCHAR(100),
    route VARCHAR(200),
    is_core BOOLEAN NOT NULL DEFAULT FALSE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT check_module_self_reference CHECK (parent_module_id IS NULL OR parent_module_id <> id)
);

-- ============================================================================
-- 2. TENANCY MANAGEMENT TABLES
-- ============================================================================

CREATE TABLE IF NOT EXISTS tenants (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    display_name VARCHAR(255),
    subdomain VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL,
    timezone VARCHAR(100) NOT NULL DEFAULT 'UTC',
    currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    locale VARCHAR(20) NOT NULL DEFAULT 'en_US',
    status tenant_status_enum NOT NULL DEFAULT 'trial',
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_tenant_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        )
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_subdomain_active
    ON tenants(subdomain)
    WHERE is_deleted = FALSE;

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_slug_active
    ON tenants(slug)
    WHERE is_deleted = FALSE;

CREATE TABLE IF NOT EXISTS tenant_subscriptions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    subscription_plan_id UUID NOT NULL REFERENCES subscription_plans(id) ON DELETE RESTRICT,
    status subscription_status_enum NOT NULL DEFAULT 'active',
    starts_at TIMESTAMPTZ NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_sub_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT check_subscription_dates CHECK (starts_at < expires_at)
);

CREATE TABLE IF NOT EXISTS tenant_modules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    module_id UUID NOT NULL REFERENCES modules(id) ON DELETE CASCADE,
    enabled BOOLEAN NOT NULL DEFAULT TRUE,
    enabled_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    enabled_by UUID,
    enabled_reason TEXT,
    disabled_at TIMESTAMPTZ,
    disabled_by UUID,
    CONSTRAINT unique_tenant_module UNIQUE (tenant_id, module_id),
    CONSTRAINT check_tenant_module_lifecycle
        CHECK (
            (enabled = TRUE AND disabled_at IS NULL)
            OR
            (enabled = FALSE AND disabled_at IS NOT NULL)
        )
);

-- ============================================================================
-- 3. BUSINESS STRUCTURE
-- ============================================================================

CREATE TABLE IF NOT EXISTS organizations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    code VARCHAR(50) NOT NULL,
    name VARCHAR(255) NOT NULL,
    legal_name VARCHAR(255),
    gst_no VARCHAR(50),
    pan_no VARCHAR(50),
    cin_no VARCHAR(50),
    email VARCHAR(255),
    phone VARCHAR(50),
    website VARCHAR(255),
    base_currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    fiscal_calendar VARCHAR(50) NOT NULL DEFAULT 'standard',
    status org_status_enum NOT NULL DEFAULT 'active',
    is_default BOOLEAN NOT NULL DEFAULT FALSE,
    remarks TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT uq_org_id_tenant UNIQUE (id, tenant_id),
    CONSTRAINT check_org_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT check_org_default_status CHECK (NOT (is_default AND status = 'archived'))
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_org_code_active
    ON organizations (tenant_id, code)
    WHERE is_deleted = FALSE;

CREATE UNIQUE INDEX IF NOT EXISTS uq_default_organization
    ON organizations (tenant_id)
    WHERE is_default = TRUE AND is_deleted = FALSE;

CREATE TABLE IF NOT EXISTS branches (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    organization_id UUID NOT NULL,
    code VARCHAR(50) NOT NULL,
    name VARCHAR(255) NOT NULL,
    status org_status_enum NOT NULL DEFAULT 'active',
    is_head_office BOOLEAN NOT NULL DEFAULT FALSE,
    is_default BOOLEAN NOT NULL DEFAULT FALSE,
    address_line1 TEXT,
    address_line2 TEXT,
    city VARCHAR(100),
    district VARCHAR(100),
    state VARCHAR(100),
    country VARCHAR(100),
    postal_code VARCHAR(20),
    timezone VARCHAR(100) NOT NULL DEFAULT 'UTC',
    remarks TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT fk_branch_org_tenant
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT uq_branch_id_tenant UNIQUE (id, tenant_id),
    CONSTRAINT check_branch_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT uq_org_branch_code UNIQUE (organization_id, code)
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_branch_code_active
    ON branches (tenant_id, code)
    WHERE is_deleted = FALSE;

CREATE UNIQUE INDEX IF NOT EXISTS uq_head_office
    ON branches (organization_id)
    WHERE is_head_office = TRUE AND is_deleted = FALSE;

CREATE UNIQUE INDEX IF NOT EXISTS uq_default_branch
    ON branches (organization_id)
    WHERE is_default = TRUE AND is_deleted = FALSE;

-- ============================================================================
-- 4. IDENTITY & SECURITY
-- ============================================================================

CREATE TABLE IF NOT EXISTS users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    organization_id UUID,
    default_branch_id UUID,
    username VARCHAR(150) NOT NULL,
    email CITEXT NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    status user_status_enum NOT NULL DEFAULT 'active',
    email_verified_at TIMESTAMPTZ,
    password_reset_token_hash VARCHAR(255),
    password_reset_expires_at TIMESTAMPTZ,
    failed_login_count INTEGER NOT NULL DEFAULT 0 CHECK (failed_login_count >= 0),
    locked_until TIMESTAMPTZ,
    mfa_enabled BOOLEAN NOT NULL DEFAULT FALSE,
    encrypted_mfa_secret TEXT,
    password_changed_at TIMESTAMPTZ,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT fk_user_org_tenant
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT fk_user_branch_tenant
        FOREIGN KEY (default_branch_id, tenant_id)
        REFERENCES branches(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT check_user_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT uq_user_id_tenant UNIQUE (id, tenant_id),
    CONSTRAINT check_user_reset_expiry
        CHECK (
            password_reset_expires_at IS NULL
            OR password_reset_token_hash IS NOT NULL
        )
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_email_active
    ON users (tenant_id, email)
    WHERE is_deleted = FALSE;

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_username_active
    ON users (tenant_id, username)
    WHERE is_deleted = FALSE;

CREATE TABLE IF NOT EXISTS user_sessions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL,
    organization_id UUID,
    branch_id UUID,
    access_token_id VARCHAR(255) UNIQUE,
    refresh_token_hash VARCHAR(255) NOT NULL UNIQUE,
    device VARCHAR(255),
    user_agent TEXT,
    ip_address VARCHAR(45),
    location VARCHAR(255),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    revoked_at TIMESTAMPTZ,
    revoked_by UUID,
    termination_reason VARCHAR(100),
    login_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    last_activity_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    expires_at TIMESTAMPTZ NOT NULL,
    logout_at TIMESTAMPTZ,
    updated_at TIMESTAMPTZ,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT fk_session_user_tenant
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_session_org_tenant
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT fk_session_branch_tenant
        FOREIGN KEY (branch_id, tenant_id)
        REFERENCES branches(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT check_session_expiry CHECK (expires_at > login_at),
    CONSTRAINT check_session_activity CHECK (last_activity_at >= login_at),
    CONSTRAINT check_session_logout CHECK (logout_at IS NULL OR logout_at >= login_at),
    CONSTRAINT check_session_revocation_coherence
        CHECK (
            (revoked_at IS NULL AND termination_reason IS NULL)
            OR
            (revoked_at IS NOT NULL)
        )
);

CREATE TABLE IF NOT EXISTS roles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    code VARCHAR(50) NOT NULL,
    name VARCHAR(100) NOT NULL,
    description TEXT,
    is_system BOOLEAN NOT NULL DEFAULT FALSE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_role_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT uq_role_id_tenant UNIQUE (id, tenant_id)
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_role_name_active
    ON roles (tenant_id, name)
    WHERE is_deleted = FALSE;

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_role_code_active
    ON roles (tenant_id, code)
    WHERE is_deleted = FALSE;

CREATE TABLE IF NOT EXISTS permissions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    module_code VARCHAR(100) NOT NULL,
    resource VARCHAR(100) NOT NULL,
    action VARCHAR(50) NOT NULL,
    scope permission_scope_enum NOT NULL DEFAULT 'tenant',
    permission_key VARCHAR(150) NOT NULL UNIQUE,
    display_name VARCHAR(150) NOT NULL,
    description TEXT,
    is_system BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE TABLE IF NOT EXISTS role_permissions (
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    role_id UUID NOT NULL,
    permission_id UUID NOT NULL REFERENCES permissions(id) ON DELETE CASCADE,
    PRIMARY KEY (role_id, permission_id, tenant_id),
    CONSTRAINT fk_role_permissions_role
        FOREIGN KEY (role_id, tenant_id)
        REFERENCES roles(id, tenant_id)
        ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS user_roles (
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL,
    role_id UUID NOT NULL,
    PRIMARY KEY (user_id, role_id, tenant_id),
    CONSTRAINT fk_user_roles_user
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_user_roles_role
        FOREIGN KEY (role_id, tenant_id)
        REFERENCES roles(id, tenant_id)
        ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS user_permissions (
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL,
    permission_id UUID NOT NULL REFERENCES permissions(id) ON DELETE CASCADE,
    allow BOOLEAN NOT NULL DEFAULT TRUE,
    PRIMARY KEY (user_id, permission_id, tenant_id),
    CONSTRAINT fk_user_perms_user
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS user_organization_access (
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL,
    organization_id UUID NOT NULL,
    PRIMARY KEY (user_id, organization_id, tenant_id),
    CONSTRAINT fk_uo_access_user
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_uo_access_org
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS user_branch_access (
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL,
    branch_id UUID NOT NULL,
    PRIMARY KEY (user_id, branch_id, tenant_id),
    CONSTRAINT fk_ub_access_user
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_ub_access_branch
        FOREIGN KEY (branch_id, tenant_id)
        REFERENCES branches(id, tenant_id)
        ON DELETE CASCADE
);

-- ============================================================================
-- 5. BUSINESS STRUCTURE CONTINUATION
-- ============================================================================

CREATE TABLE IF NOT EXISTS financial_years (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    organization_id UUID NOT NULL,
    name VARCHAR(100) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    status fy_status_enum NOT NULL DEFAULT 'open',
    is_active BOOLEAN NOT NULL DEFAULT FALSE,
    is_locked BOOLEAN NOT NULL DEFAULT FALSE,
    remarks TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_financial_year_dates CHECK (start_date < end_date),
    CONSTRAINT fk_fy_org_tenant
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT check_fy_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT uq_fy_id_tenant UNIQUE (id, tenant_id),
    CONSTRAINT check_fy_locked_status
        CHECK (NOT (is_locked = TRUE AND status = 'open'))
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_active_financial_year
    ON financial_years (tenant_id, organization_id)
    WHERE is_active = TRUE AND is_deleted = FALSE;

-- ============================================================================
-- 6. GOVERNANCE & LOGGING
-- ============================================================================

CREATE TABLE IF NOT EXISTS audit_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE RESTRICT,
    table_schema VARCHAR(100) NOT NULL DEFAULT 'public',
    entity_name VARCHAR(100) NOT NULL,
    record_id UUID NOT NULL,
    action audit_action_enum NOT NULL,
    old_data JSONB,
    new_data JSONB,
    affected_columns TEXT[],
    performed_by_user_id UUID,
    performed_by_name VARCHAR(255),
    performed_by_email VARCHAR(255),
    tenant_name VARCHAR(255),
    organization_name VARCHAR(255),
    branch_name VARCHAR(255),
    performed_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    request_id VARCHAR(100),
    correlation_id UUID,
    transaction_id UUID,
    duration_ms INTEGER,
    ip_address VARCHAR(45),
    browser VARCHAR(255),
    device VARCHAR(255),
    CONSTRAINT check_audit_duration_nonnegative CHECK (duration_ms IS NULL OR duration_ms >= 0)
);

CREATE TABLE IF NOT EXISTS activity_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE RESTRICT,
    user_id UUID,
    user_name VARCHAR(255),
    entity_name VARCHAR(100),
    record_id UUID,
    action VARCHAR(150) NOT NULL,
    description TEXT,
    ip_address VARCHAR(45),
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ============================================================================
-- 7. DOCUMENTS
-- ============================================================================

CREATE TABLE IF NOT EXISTS document_types (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    code VARCHAR(50) NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    remarks TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_doctype_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT uq_doctype_id_tenant UNIQUE (id, tenant_id)
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_doc_type_active
    ON document_types (tenant_id, code)
    WHERE is_deleted = FALSE;

CREATE TABLE IF NOT EXISTS document_sequences (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    document_type_id UUID NOT NULL,
    branch_id UUID,
    financial_year_id UUID,
    prefix VARCHAR(50) NOT NULL DEFAULT '',
    suffix VARCHAR(50) NOT NULL DEFAULT '',
    padding INTEGER NOT NULL DEFAULT 6 CHECK (padding > 0),
    current_number BIGINT NOT NULL DEFAULT 0 CHECK (current_number >= 0),
    minimum_number BIGINT NOT NULL DEFAULT 0 CHECK (minimum_number >= 0),
    maximum_number BIGINT,
    increment_by INTEGER NOT NULL DEFAULT 1 CHECK (increment_by > 0),
    reset_policy reset_policy_enum NOT NULL DEFAULT 'financial_year',
    is_default BOOLEAN NOT NULL DEFAULT FALSE,
    last_generated_number VARCHAR(100),
    last_used_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT unique_document_sequence UNIQUE (tenant_id, document_type_id, branch_id, financial_year_id),
    CONSTRAINT check_sequence_max_min CHECK (maximum_number IS NULL OR maximum_number >= minimum_number),
    CONSTRAINT check_current_vs_min CHECK (current_number >= minimum_number),
    CONSTRAINT check_current_vs_max CHECK (maximum_number IS NULL OR current_number <= maximum_number),
    CONSTRAINT fk_docseq_type_tenant
        FOREIGN KEY (document_type_id, tenant_id)
        REFERENCES document_types(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_docseq_branch_tenant
        FOREIGN KEY (branch_id, tenant_id)
        REFERENCES branches(id, tenant_id)
        ON DELETE CASCADE,
    CONSTRAINT fk_docseq_fy_tenant
        FOREIGN KEY (financial_year_id, tenant_id)
        REFERENCES financial_years(id, tenant_id)
        ON DELETE CASCADE
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_default_document_sequence
    ON document_sequences (tenant_id, document_type_id)
    WHERE is_default = TRUE;

-- ============================================================================
-- 8. SHARED SERVICES
-- ============================================================================

CREATE TABLE IF NOT EXISTS attachments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    organization_id UUID,
    branch_id UUID,
    module VARCHAR(100) NOT NULL,
    record_id UUID NOT NULL,
    file_name VARCHAR(255) NOT NULL,
    original_file_name VARCHAR(255) NOT NULL,
    extension VARCHAR(50) NOT NULL,
    file_path TEXT NOT NULL,
    thumbnail_path TEXT,
    preview_path TEXT,
    file_size BIGINT NOT NULL DEFAULT 0 CHECK (file_size >= 0),
    checksum VARCHAR(128),
    storage_provider storage_provider_enum NOT NULL DEFAULT 'local',
    storage_bucket VARCHAR(150),
    mime_type VARCHAR(100),
    is_public BOOLEAN NOT NULL DEFAULT FALSE,
    is_encrypted BOOLEAN NOT NULL DEFAULT FALSE,
    encryption_key_id VARCHAR(100),
    virus_scan_status scan_status_enum NOT NULL DEFAULT 'pending',
    virus_scan_version VARCHAR(50),
    virus_scanned_at TIMESTAMPTZ,
    scan_engine VARCHAR(100),
    quarantined BOOLEAN NOT NULL DEFAULT FALSE,
    scan_message TEXT,
    metadata JSONB,
    uploaded_by UUID,
    uploaded_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_attachment_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT fk_attachment_org_tenant
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT fk_attachment_branch_tenant
        FOREIGN KEY (branch_id, tenant_id)
        REFERENCES branches(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT check_attachment_scan_consistency
        CHECK (
            (quarantined = FALSE)
            OR
            (quarantined = TRUE AND virus_scan_status IN ('infected', 'quarantined'))
        ),
    CONSTRAINT check_attachment_scan_time
        CHECK (virus_scanned_at IS NULL OR virus_scanned_at >= uploaded_at)
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_tenant_attachment_checksum
    ON attachments (tenant_id, checksum)
    WHERE is_deleted = FALSE AND checksum IS NOT NULL;

CREATE TABLE IF NOT EXISTS notifications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    organization_id UUID,
    branch_id UUID,
    user_id UUID NOT NULL,
    title VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    type notification_type_enum NOT NULL DEFAULT 'info',
    link TEXT,
    is_read BOOLEAN NOT NULL DEFAULT FALSE,
    read_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ,
    deleted_at TIMESTAMPTZ,
    deleted_by UUID,
    is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT check_notification_read_time CHECK (read_at IS NULL OR read_at >= created_at),
    CONSTRAINT check_notification_read_flag
        CHECK (
            (is_read = FALSE AND read_at IS NULL)
            OR
            (is_read = TRUE AND read_at IS NOT NULL)
        ),
    CONSTRAINT check_notification_soft_delete
        CHECK (
            (is_deleted = FALSE AND deleted_at IS NULL)
            OR
            (is_deleted = TRUE AND deleted_at IS NOT NULL)
        ),
    CONSTRAINT fk_notification_org_tenant
        FOREIGN KEY (organization_id, tenant_id)
        REFERENCES organizations(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT fk_notification_branch_tenant
        FOREIGN KEY (branch_id, tenant_id)
        REFERENCES branches(id, tenant_id)
        ON DELETE SET NULL,
    CONSTRAINT fk_notification_user_tenant
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS tenant_settings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    category VARCHAR(100) NOT NULL DEFAULT 'general',
    key VARCHAR(150) NOT NULL,
    value TEXT,
    encrypted_value TEXT,
    data_type VARCHAR(50) NOT NULL DEFAULT 'string',
    is_secret BOOLEAN NOT NULL DEFAULT FALSE,
    description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    created_by UUID,
    updated_at TIMESTAMPTZ,
    updated_by UUID,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT unique_tenant_setting_key UNIQUE (tenant_id, key),
    CONSTRAINT check_setting_value_presence CHECK ((value IS NULL) <> (encrypted_value IS NULL)),
    CONSTRAINT check_secret_encryption CHECK (NOT (is_secret = FALSE AND encrypted_value IS NOT NULL)),
    CONSTRAINT check_secret_plaintext CHECK (NOT (is_secret = TRUE AND value IS NOT NULL))
);

CREATE TABLE IF NOT EXISTS user_settings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    user_id UUID NOT NULL,
    category VARCHAR(100) NOT NULL DEFAULT 'general',
    key VARCHAR(150) NOT NULL,
    value TEXT NOT NULL,
    data_type VARCHAR(50) NOT NULL DEFAULT 'string',
    created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at TIMESTAMPTZ,
    version INTEGER NOT NULL DEFAULT 1 CHECK (version > 0),
    CONSTRAINT unique_user_setting_key UNIQUE (tenant_id, user_id, key),
    CONSTRAINT fk_user_settings_user_tenant
        FOREIGN KEY (user_id, tenant_id)
        REFERENCES users(id, tenant_id)
        ON DELETE CASCADE
);

