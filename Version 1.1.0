DROP POLICY IF EXISTS tenant_isolation_policy ON tenants;
CREATE POLICY tenant_isolation_policy ON tenants
    FOR ALL
    USING (id = app_current_tenant_id())
    WITH CHECK (id = app_current_tenant_id());

