-- ============================================================================
-- COMMENTS
-- ============================================================================

COMMENT ON TABLE tenants IS 'Represents one customer using the ERP SaaS platform.';
COMMENT ON TABLE organizations IS 'Legal companies owned by a tenant.';
COMMENT ON TABLE branches IS 'Physical business locations.';
COMMENT ON TABLE audit_logs IS 'Append-only immutable governance log protected by trigger constraints and restricted retention.';
COMMENT ON FUNCTION app_current_tenant_id() IS 'Returns current tenant UUID from app.current_tenant_id custom setting.';

